DB_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-another-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-before-first-start
RECONCILE_ON_ASSIGN=true

# Override this if your GitHub repository/image name differs.
SHARE_MANAGER_IMAGE=ghcr.io/zeragonii/share-manager:latest

BILLING_CHECK_INTERVAL_MINUTES=15

# How many days before paid-through to emit subscription.due_soon. Set 0 to disable.
NOTIFICATION_DUE_SOON_DAYS=3

# Disaster recovery. Point this at storage independent of the PostgreSQL disk.
BACKUP_HOST_PATH=./backups
BACKUP_SCHEDULE_HOUR=3
BACKUP_CHECK_INTERVAL_MINUTES=5
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
